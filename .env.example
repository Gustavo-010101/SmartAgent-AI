DB_NAME=smartagent_ai

# TiDB Cloud
TIDB_HOST=seu_host_tidb
TIDB_PORT=4000
TIDB_USER=seu_usuario_tidb
TIDB_PASSWORD=sua_senha_tidb
TIDB_DATABASE=smartagent_ai
TIDB_SSL_CA=certificados/tidb-ca.pem