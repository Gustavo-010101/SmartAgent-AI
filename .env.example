# Provedor de inteligência artificial
PROVEDOR_IA=ollama
GROQ_API_KEY=sua_chave_groq

# Modo de execução
MODO_PUBLICO=false

# Provedor de banco de dados
PROVEDOR_DB=mysql

# MySQL local
DB_HOST=localhost
